# =============================================================================
# .env.example — Native Local Development Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB (Running locally on localhost:5432)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=NIDS

# Async SQLAlchemy URL used by the FastAPI backend and background worker.
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/NIDS

# -----------------------------------------------------------------------------
# Redis (Running locally on localhost:6379)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Ingestion Mode
# -----------------------------------------------------------------------------
CAPTURE_MODE=replay
PCAP_PATH=data/sample.pcap
PCAP_REPLAY_SPEED=1.0

# -----------------------------------------------------------------------------
# ML Model Artifacts
# -----------------------------------------------------------------------------
MODEL_ARTIFACTS_DIR=ml/artifacts
CLASSIFIER_MODEL_PATH=ml/artifacts/classifier.pkl
AUTOENCODER_MODEL_PATH=ml/artifacts/autoencoder.pt
SCALER_PATH=ml/artifacts/scaler.pkl
AUTOENCODER_THRESHOLD=0.04165823
STAGE1_CONFIDENCE_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Security & JWT Auth
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_secret_key
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
